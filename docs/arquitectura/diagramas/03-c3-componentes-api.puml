@startuml c3-componentes-api
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title C3 · Diagrama de componentes — Contenedor «API» (Spring Boot)

Container(spa, "SPA Angular", "TypeScript", "IU-01 a IU-04")
ContainerDb(db, "MariaDB", "SQL")
System_Ext(banco, "Pasarela de pago")
System_Ext(dian, "DIAN")

Container_Boundary(api, "API Spring Boot") {
  Component(seg, "Seguridad", "SecurityConfig, TokenService, AutenticacionStompInterceptor", "JWT HS256, RBAC por operación y por tópico STOMP")
  Component(ctl, "Controladores REST", "Auth, Mesa, Menu, Pedido, EntregaComanda, Caja, Inventario", "Validan la entrada y delegan en un servicio")
  Component(mesaS, "MesaService", "Servicio", "F-01 estado de mesas y pedido activo")
  Component(menuS, "MenuService", "Servicio", "F-02 menú con disponibilidad")
  Component(regla, "ReglaDisponibilidad", "Strategy", "DisponibilidadPorReceta: receta vs. stock")
  Component(pedS, "PedidoService", "Facade · Contratos 1 y 2", "Registrar, cocina, notificar, servir, anular, solicitar cuenta")
  Component(cons, "ConsumoIngredientesPedido", "Servicio", "Bloquea ingredientes, valida, descuenta y reintegra stock")
  Component(cola, "ColaComandas + PresenciaCocina", "Outbox + Observer", "F-08: ACK, reenvío ordenado, cocina conectada")
  Component(cajaS, "CajaService", "Facade · Contrato 3", "Cuentas, cobro y factura electrónica")
  Component(proc, "ProcesadorPago", "Strategy", "PagoEfectivo, PagoTarjeta")
  Component(pas, "PasarelaPago", "Puerto + Adapter", "PasarelaPagoSimulada")
  Component(fe, "ServicioFacturacionElectronica", "Puerto + Adapter", "DianSimulada, CalculadoraCufe")
  Component(cierre, "CierreCajaService", "Servicio · JornadaOperativa", "Conciliación, cierre y reporte diario")
  Component(inv, "InventarioService", "Servicio", "Stock y entradas")
  Component(pub, "PublicadorTiempoReal", "Observer · @TransactionalEventListener", "Difunde eventos de dominio por STOMP después del commit")
  Component(repo, "Repositorios", "Spring Data JPA", "Pedido, Mesa, ProductoMenu, Ingrediente, EntregaComanda, Factura, CierreCaja…")
}

Rel(spa, seg, "JWT en cada petición y en CONNECT", "HTTPS/WSS")
Rel(seg, ctl, "Petición autenticada")
Rel(ctl, mesaS, "")
Rel(ctl, menuS, "")
Rel(ctl, pedS, "")
Rel(ctl, cola, "ACK / estado")
Rel(ctl, cajaS, "")
Rel(ctl, cierre, "")
Rel(ctl, inv, "")
Rel(menuS, regla, "usa")
Rel(pedS, cons, "reserva / descuenta")
Rel(cons, regla, "usa")
Rel(pedS, cierre, "¿caja abierta? (JornadaOperativa)")
Rel(cajaS, proc, "procesa cada parte")
Rel(proc, pas, "tarjeta")
Rel(cajaS, fe, "valida factura")
Rel(cierre, fe, "reporte diario")
Rel(pas, banco, "REST/HTTPS")
Rel(fe, dian, "SOAP/HTTPS")
Rel(pedS, pub, "eventos de dominio")
Rel(pedS, cola, "PedidoCambiado (evento)")
Rel(cajaS, pub, "eventos de dominio")
Rel(pub, spa, "/topic/*", "STOMP")
Rel(pedS, repo, "")
Rel(cajaS, repo, "")
Rel(cola, repo, "")
Rel(repo, db, "JDBC")
@enduml
