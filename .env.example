# Copie este archivo como .env y ajuste los valores:  cp .env.example .env
# El archivo .env NO se sube al repositorio.

# Nombre que aparece en el encabezado de las pantallas
RESTAURANTE_NOMBRE=El Buen Sabor

# Base de datos (MariaDB)
DB_NAME=comanda
DB_USER=comanda
DB_PASSWORD=comanda_dev
DB_ROOT_PASSWORD=root_dev

# Clave para firmar los tokens de sesión (mínimo 32 caracteres)
JWT_SECRET=cambie-este-secreto-por-una-cadena-larga-y-aleatoria

# Orígenes permitidos para la API y el WebSocket. Incluye la red local para
# poder abrir la app desde una tablet (http://<IP-del-PC>:8081)
CORS_ORIGENES=http://localhost:[*],http://127.0.0.1:[*],http://192.168.*.*:[*],http://10.*.*.*:[*]

# Puertos en su máquina
FRONTEND_PUERTO=8081
BACKEND_PUERTO=8080
DB_PUERTO_LOCAL=3307

TZ=America/Bogota
